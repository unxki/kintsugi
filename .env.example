# Database Configuration (Postgres with pgvector)
DATABASE_URL=postgresql+asyncpg://kintsugi:kintsugi_secret@localhost:5432/kintsugi_db
# Local SQLite fallback for unit tests:
# DATABASE_URL=sqlite+aiosqlite:///./kintsugi.db

# LLM Diagnostics Provider ("heuristic", "openai", "gemini", "anthropic")
LLM_PROVIDER=heuristic
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini

# Sentinel Daemon Communication
SENTINEL_ENDPOINT=http://localhost:8081
CORE_API_ENDPOINT=http://localhost:8000/api/v1

# Sentinel Guardrails
FLAP_THRESHOLD=3
FLAP_WINDOW_SECONDS=60
LOG_TAIL_LINES=100
